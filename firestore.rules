rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }
    function text(value, maximum) {
      return value is string && value.size() > 0 && value.size() <= maximum && value.matches('(?s).*[^\\s].*');
    }
    function validPost(slug) {
      let p = request.resource.data;
      return p.keys().hasAll(['slug', 'title', 'excerpt', 'category', 'content', 'publishedAt', 'status', 'revision', 'createdAt', 'updatedAt'])
        && p.keys().hasOnly(['slug', 'title', 'excerpt', 'category', 'content', 'publishedAt', 'status', 'revision', 'createdAt', 'updatedAt'])
        && p.slug == slug && slug.size() <= 100 && slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && text(p.title, 160) && text(p.excerpt, 500) && text(p.category, 80) && text(p.content, 60000)
        && p.status in ['draft', 'published']
        && p.publishedAt is string
        && (p.publishedAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') || (p.status == 'draft' && p.publishedAt == ''))
        && p.revision is int && p.revision > 0
        && p.createdAt is timestamp && p.updatedAt == request.time;
    }
    // Only a trusted project operator can grant/revoke admin membership.
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /blogPosts/{slug} {
      allow get, list: if admin() || resource.data.status == 'published';
      allow create: if admin() && validPost(slug)
        && request.resource.data.revision == 1 && request.resource.data.createdAt == request.time;
      allow update: if admin() && validPost(slug)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }
    // Future private apps require their own explicit rules.
    match /{document=**} { allow read, write: if false; }
  }
}
