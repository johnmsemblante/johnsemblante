rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() {
      return request.auth != null && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }
    function text(value, maximum) {
      return value is string && value.size() > 0 && value.size() <= maximum && value.matches('(?s).*[^\\s].*');
    }
    function labelAt(labels, i) { return labels.size() <= i || text(labels[i], 80); }
    function labels(value, minimum, maximum) {
      return value is list && value.size() >= minimum && value.size() <= maximum && value.toSet().size() == value.size()
        && labelAt(value, 0) && labelAt(value, 1) && labelAt(value, 2) && labelAt(value, 3) && labelAt(value, 4)
        && labelAt(value, 5) && labelAt(value, 6) && labelAt(value, 7) && labelAt(value, 8) && labelAt(value, 9)
        && labelAt(value, 10) && labelAt(value, 11) && labelAt(value, 12) && labelAt(value, 13) && labelAt(value, 14)
        && labelAt(value, 15) && labelAt(value, 16) && labelAt(value, 17) && labelAt(value, 18) && labelAt(value, 19);
    }
    function validPost(slug) {
      let p = request.resource.data;
      return p.keys().hasAll(['schemaVersion', 'slug', 'title', 'excerpt', 'category', 'categories', 'tags', 'content', 'publishedAt', 'releaseAt', 'status', 'seoTitle', 'seoDescription', 'revision', 'createdAt', 'updatedAt'])
        && p.keys().hasOnly(['schemaVersion', 'slug', 'title', 'excerpt', 'category', 'categories', 'tags', 'content', 'publishedAt', 'releaseAt', 'status', 'seoTitle', 'seoDescription', 'revision', 'createdAt', 'updatedAt'])
        && p.schemaVersion == 2 && p.slug == slug && slug.size() <= 100 && slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && text(p.title, 160) && text(p.excerpt, 500) && text(p.content, 60000)
        && labels(p.categories, 1, 10) && p.category == p.categories[0] && labels(p.tags, 0, 20)
        && p.seoTitle is string && p.seoTitle.size() <= 160 && p.seoDescription is string && p.seoDescription.size() <= 500
        && p.status in ['draft', 'published', 'scheduled']
        && p.releaseAt is int
        && ((p.status == 'draft' && p.publishedAt == null && p.releaseAt == 0)
          || (p.status == 'published' && p.publishedAt is timestamp && p.publishedAt <= request.time && p.releaseAt == 0)
          || (p.status == 'scheduled' && p.publishedAt is timestamp && p.releaseAt > request.time.toMillis() && p.releaseAt == p.publishedAt.toMillis()))
        && p.revision is int && p.revision > 0 && p.createdAt is timestamp && p.updatedAt == request.time;
    }
    function validPublicationUpdate() {
      let p = request.resource.data;
      let old = resource.data;
      return p.status != 'published' || p.publishedAt == request.time
        || (old.status == 'published' && (old.get('schemaVersion', 1) == 1 || p.publishedAt == old.publishedAt))
        || (old.status == 'scheduled' && old.publishedAt <= request.time && p.publishedAt == old.publishedAt);
    }
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }
    function validSavedJob(id) {
      let j = request.resource.data;
      return j.keys().hasAll(['sourceId', 'source', 'title', 'company', 'location', 'remote', 'url', 'postedAt', 'savedAt'])
        && j.keys().hasOnly(['sourceId', 'source', 'title', 'company', 'location', 'remote', 'url', 'postedAt', 'savedAt', 'summary', 'salary', 'employment', 'timezone', 'expiresAt'])
        && j.sourceId == id && id.size() <= 500 && id.matches('^[a-zA-Z0-9-]+$')
        && text(j.title, 400) && text(j.company, 200) && text(j.location, 300)
        && (j.remote == null || j.remote is bool)
        && j.url is string && j.url.size() <= 2000
        && ((j.source == 'Arbeitnow' && j.url.matches('^https://(www[.])?arbeitnow[.]com/jobs/[^\\s]+$'))
          || (j.source == 'Jobicy' && id.matches('^jobicy-[1-9][0-9]*$') && j.remote == true && j.url.matches('^https://jobicy[.]com/jobs/[^\\s]+$'))
          || (j.source == 'Himalayas' && id.matches('^himalayas-[1-9][0-9]*-[a-z0-9-]+$') && j.remote == true && j.url.matches('^https://himalayas[.]app/companies/[a-z0-9-]+/jobs/[a-z0-9-]+([?][^\\s]*)?$')))
        && j.get('summary', '') is string && j.get('summary', '').size() <= 700
        && j.get('salary', '') is string && j.get('salary', '').size() <= 200
        && j.get('employment', '') is string && j.get('employment', '').size() <= 120
        && j.get('timezone', '') is string && j.get('timezone', '').size() <= 120
        && j.get('expiresAt', 0) is int && j.get('expiresAt', 0) >= 0 && j.get('expiresAt', 0) <= 8640000000000000
        && (j.postedAt == null || (j.postedAt is int && j.postedAt > 0 && j.postedAt <= 8640000000000000))
        && j.savedAt == request.time;
    }
    match /admins/{uid}/savedJobs/{id} {
      allow read: if admin() && request.auth.uid == uid;
      allow create, update: if admin() && request.auth.uid == uid && validSavedJob(id);
      allow delete: if admin() && request.auth.uid == uid;
    }
    match /blogPosts/{slug} {
      // Published legacy posts remain readable. Schedules use the server clock, never the visitor's clock, for access.
      allow get, list: if admin() || resource.data.status == 'published'
        || (resource.data.status == 'scheduled' && resource.data.releaseAt <= request.time.toMillis());
      allow create: if admin() && validPost(slug) && request.resource.data.revision == 1
        && request.resource.data.createdAt == request.time
        && (request.resource.data.status != 'published' || request.resource.data.publishedAt == request.time);
      allow update: if admin() && validPost(slug) && validPublicationUpdate()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if admin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
