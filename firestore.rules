rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() {
      return request.auth != null && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }
    function text(value, maximum) {
      return value is string && value.size() > 0 && value.size() <= maximum && value.matches('(?s).*[^\\s].*');
    }
    function labelStrings(value, count) {
      return (count <= 0 || value[0] is string)
        && (count <= 1 || value[1] is string)
        && (count <= 2 || value[2] is string)
        && (count <= 3 || value[3] is string)
        && (count <= 4 || value[4] is string)
        && (count <= 5 || value[5] is string)
        && (count <= 6 || value[6] is string)
        && (count <= 7 || value[7] is string)
        && (count <= 8 || value[8] is string)
        && (count <= 9 || value[9] is string)
        && (count <= 10 || value[10] is string)
        && (count <= 11 || value[11] is string)
        && (count <= 12 || value[12] is string)
        && (count <= 13 || value[13] is string)
        && (count <= 14 || value[14] is string)
        && (count <= 15 || value[15] is string)
        && (count <= 16 || value[16] is string)
        && (count <= 17 || value[17] is string)
        && (count <= 18 || value[18] is string)
        && (count <= 19 || value[19] is string);
    }
    function labels(value, minimum, maximum) {
      let count = value.size();
      let joined = value.join('\u0000');
      // Preserve item boundaries to validate all labels
      // without evaluating a separate chain of functions for every array entry.
      return value is list && count >= minimum && count <= maximum && value.toSet().size() == count && labelStrings(value, count)
        && (count == 0 || (joined.split('\u0000').size() == count
          && joined.matches('(?s)[^\x00]{1,80}(\x00[^\x00]{1,80})*')
          && !joined.matches('(?s)(.*\x00)?\\s*(\x00.*)?')));
    }
    function validPost(slug) {
      let p = request.resource.data;
      return p.keys().hasAll(['schemaVersion', 'slug', 'title', 'excerpt', 'category', 'categories', 'tags', 'content', 'publishedAt', 'releaseAt', 'status', 'seoTitle', 'seoDescription', 'revision', 'createdAt', 'updatedAt'])
        && p.keys().hasOnly(['schemaVersion', 'slug', 'title', 'excerpt', 'category', 'categories', 'tags', 'content', 'publishedAt', 'releaseAt', 'status', 'seoTitle', 'seoDescription', 'revision', 'createdAt', 'updatedAt', 'featuredImage', 'featuredImageAlt'])
        && p.schemaVersion == 2 && p.slug == slug && slug.size() <= 100 && slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && text(p.title, 160) && text(p.excerpt, 500) && text(p.content, 60000)
        && labels(p.categories, 1, 10) && p.category == p.categories[0] && labels(p.tags, 0, 20)
        && p.seoTitle is string && p.seoTitle.size() <= 160 && p.seoDescription is string && p.seoDescription.size() <= 500
        && p.get('featuredImage', '') is string && p.get('featuredImage', '').size() <= 2000
        && (p.get('featuredImage', '') == '' || p.featuredImage.matches('^https://[^\\s<>]+$') || p.featuredImage.matches('^/[^/\\s<>][^\\s<>]*$'))
        && p.get('featuredImageAlt', '') is string && p.get('featuredImageAlt', '').size() <= 200
        && p.status in ['draft', 'published', 'scheduled']
        && p.releaseAt is int
        && ((p.status == 'draft' && p.publishedAt == null && p.releaseAt == 0)
          || (p.status == 'published' && p.publishedAt is timestamp && p.publishedAt <= request.time && p.releaseAt == 0)
          || (p.status == 'scheduled' && p.publishedAt is timestamp && p.releaseAt > request.time.toMillis() && p.releaseAt == p.publishedAt.toMillis()))
        && p.revision is int && p.revision > 0 && p.createdAt is timestamp && p.updatedAt == request.time;
    }
    function validPublicationUpdate() {
      let p = request.resource.data;
      let old = resource.data;
      return p.status != 'published' || p.publishedAt == request.time
        || (old.status == 'published' && (old.get('schemaVersion', 1) == 1 || p.publishedAt == old.publishedAt))
        || (old.status == 'scheduled' && old.publishedAt <= request.time && p.publishedAt == old.publishedAt);
    }
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }
    function validSavedJob(id) {
      let j = request.resource.data;
      return j.keys().hasAll(['sourceId', 'source', 'title', 'company', 'location', 'remote', 'url', 'postedAt', 'savedAt'])
        && j.keys().hasOnly(['sourceId', 'source', 'title', 'company', 'location', 'remote', 'url', 'postedAt', 'savedAt', 'summary', 'salary', 'employment', 'timezone', 'expiresAt'])
        && j.sourceId == id && id.size() <= 500 && id.matches('^[a-zA-Z0-9-]+$')
        && text(j.title, 400) && text(j.company, 200) && text(j.location, 300)
        && (j.remote == null || j.remote is bool)
        && j.url is string && j.url.size() <= 2000
        && ((j.source == 'Arbeitnow' && j.url.matches('^https://(www[.])?arbeitnow[.]com/jobs/[^\\s]+$'))
          || (j.source == 'Jobicy' && id.matches('^jobicy-[1-9][0-9]*$') && j.remote == true && j.url.matches('^https://jobicy[.]com/jobs/[^\\s]+$'))
          || (j.source == 'Himalayas' && id.matches('^himalayas-[1-9][0-9]*-[a-z0-9-]+$') && j.remote == true && j.url.matches('^https://himalayas[.]app/companies/[a-z0-9-]+/jobs/[a-z0-9-]+([?][^\\s]*)?$')))
        && j.get('summary', '') is string && j.get('summary', '').size() <= 700
        && j.get('salary', '') is string && j.get('salary', '').size() <= 200
        && j.get('employment', '') is string && j.get('employment', '').size() <= 120
        && j.get('timezone', '') is string && j.get('timezone', '').size() <= 120
        && j.get('expiresAt', 0) is int && j.get('expiresAt', 0) >= 0 && j.get('expiresAt', 0) <= 8640000000000000
        && (j.postedAt == null || (j.postedAt is int && j.postedAt > 0 && j.postedAt <= 8640000000000000))
        && j.savedAt == request.time;
    }
    match /admins/{uid}/savedJobs/{id} {
      allow read: if admin() && request.auth.uid == uid;
      allow create, update: if admin() && request.auth.uid == uid && validSavedJob(id);
      allow delete: if admin() && request.auth.uid == uid;
    }
    function workUrl(value) {
      return value is string && value.size() <= 2000 && (value == '' || value.matches('^https://[^\\s<>]+$') || value.matches('^/[^/\\s<>][^\\s<>]*$'));
    }
    function workLabels(value, minimum) {
      let count = value.size();
      let joined = value.join('\u0000');
      return value is list && count >= minimum && count <= 20 && value.toSet().size() == count
        && (count == 0 || (joined.split('\u0000') == value
          && joined.matches('(?s)[^\x00]{1,80}(\x00[^\x00]{1,80})*') && !joined.matches('(?s)(.*\x00)?\\s*(\x00.*)?')));
    }
    function validWork(p, slug) {
      return p is map && p.keys().hasAll(['slug','title','summary','role','industries','technologies','projectType','publication','status'])
        && p.keys().hasOnly(['slug','title','summary','role','industries','technologies','projectType','publication','status','description','objectives','features','contributions','tags','capabilities','gallery','seo','caseStudyUrl','challenge','approach','outcome','year','website','image'])
        && p.slug == slug && slug.size() <= 100 && slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && text(p.title,160) && text(p.summary,1000) && text(p.role,200)
        && p.projectType in ['client','venture','concept'] && p.publication in ['published','draft'] && p.status in ['archived','live','planned','in-progress']
        && p.industries is list && p.industries.size() > 0 && p.industries.size() <= 9 && p.industries.hasOnly(['dental','real-estate','healthcare','travel','food-beverage','ecommerce','hospitality','professional-services','other'])
        && workLabels(p.technologies,1) && workLabels(p.get('tags',[]),0) && workLabels(p.get('capabilities',[]),0)
        && workLabels(p.get('objectives',[]),0) && workLabels(p.get('features',[]),0) && workLabels(p.get('contributions',[]),0)
        && p.get('description','') is string && p.get('description','').size() <= 10000
        && p.get('challenge','') is string && p.get('challenge','').size() <= 10000
        && p.get('approach','') is string && p.get('approach','').size() <= 10000
        && p.get('outcome','') is string && p.get('outcome','').size() <= 10000
        && p.get('year',2000) is int && p.get('year',2000) >= 1900 && p.get('year',2000) <= 2200
        && workUrl(p.get('website','')) && workUrl(p.get('caseStudyUrl',''))
        && (!('image' in p) || (p.image is map && p.image.keys().hasOnly(['src','alt']) && text(p.image.src,2000) && workUrl(p.image.src) && text(p.image.alt,200)))
        && (!('seo' in p) || (p.seo is map && p.seo.keys().hasOnly(['title','description']) && p.seo.get('title','') is string && p.seo.get('title','').size() <= 160 && p.seo.get('description','') is string && p.seo.get('description','').size() <= 500))
        && p.get('gallery',[]) is list && p.get('gallery',[]).size() <= 20;
    }
    match /managedWorks/{slug} {
      allow read: if admin();
      allow create, update: if admin() && request.resource.data.keys().hasOnly(['project','revision','updatedAt'])
        && validWork(request.resource.data.project,slug) && request.resource.data.updatedAt == request.time
        && request.resource.data.revision is int && request.resource.data.revision == (resource == null ? 1 : resource.data.revision + 1)
        && getAfter(/databases/$(database)/documents/publicWorks/$(slug)).data == (request.resource.data.project.publication == 'published' ? {'slug':slug,'deleted':false,'project':request.resource.data.project} : {'slug':slug,'deleted':true});
      allow delete: if admin() && getAfter(/databases/$(database)/documents/publicWorks/$(slug)).data == {'slug':slug,'deleted':true};
    }
    match /publicWorks/{slug} {
      allow read: if true;
      allow create, update: if admin() && (request.resource.data == {'slug':slug,'deleted':true}
        ? (!existsAfter(/databases/$(database)/documents/managedWorks/$(slug)) || getAfter(/databases/$(database)/documents/managedWorks/$(slug)).data.project.publication == 'draft')
        : (request.resource.data.keys().hasOnly(['slug','deleted','project']) && request.resource.data.slug == slug && request.resource.data.deleted == false
          && request.resource.data.project.publication == 'published' && request.resource.data.project == getAfter(/databases/$(database)/documents/managedWorks/$(slug)).data.project));
      allow delete: if false;
    }
    match /blogPosts/{slug} {
      // Published legacy posts remain readable. Schedules use the server clock, never the visitor's clock, for access.
      allow get, list: if admin() || resource.data.status == 'published'
        || (resource.data.status == 'scheduled' && resource.data.releaseAt <= request.time.toMillis());
      allow create: if admin() && validPost(slug) && request.resource.data.revision == 1
        && request.resource.data.createdAt == request.time
        && (request.resource.data.status != 'published' || request.resource.data.publishedAt == request.time);
      allow update: if admin() && validPost(slug) && validPublicationUpdate()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if admin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
