{
  "name": "john-semblante-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev --webpack",
    "build": "node scripts/sync-blog-snapshot.cjs && node scripts/sync-works.cjs && node node_modules/next/dist/bin/next build --webpack",
    "test:forms": "node --test tests/inquiry-reset.test.cjs",
    "test:ventures": "node --test tests/ventures.test.cjs",
    "test:seo": "node --test tests/seo.test.cjs",
    "audit:seo": "node scripts/check-seo.mjs",
    "sync:blog": "node scripts/sync-blog-snapshot.cjs",
    "preview": "node scripts/preview.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test:blog": "node --test tests/blog-model.test.cjs tests/blog-loading.test.cjs tests/blog-editor.test.cjs tests/article-formatting.test.cjs tests/blog-layout.test.cjs tests/blog-refresh.test.cjs",
    "test:rules": "node --test tests/firestore-rules.test.mjs",
    "test:admin": "node --test tests/admin-dashboard.test.cjs tests/jobs.test.cjs tests/job-feed-worker.test.cjs",
    "test:work": "node --test tests/work-portfolio.test.cjs tests/project-filter-session.test.cjs tests/project-filter-dropdown.test.cjs",
    "test:work-admin": "node --test tests/work-admin.test.cjs"
  },
  "dependencies": {
    "firebase": "13.2.0",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "@grpc/grpc-js": "1.13.6"
  }
}
